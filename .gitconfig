[user]
	name = Joe Cucci
	email = jcucci@fastmail.com
[core]
    pager = delta --dark --line-numbers
[interactive]
    diffFilter = delta --color-only
[alias]
	unstate = reset HEAD --
	last = log -1 HEAD
	unstage = reset HEAD --
[include]
    path = /Users/joe.cucci/projects/system/catppuccin/delta/catppuccin.gitconfig
[delta]
    features = catppuccin-mocha
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictstyle = zdiff3
	tool = nvimdiff
[pull]
	rebase = false
[mergetool "nvimdiff"]
	layout = LOCAL,REMOTE/MERGED
[mergetool]
	keepBackup = false
	prompt = false
[rerere]
	enabled = true
# Machine/work-specific settings (untracked); keep before the GitHub helpers
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = "!f() { PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin\"; gh auth git-credential \"$@\"; }; f"
[credential "https://gist.github.com"]
	helper = 
	helper = "!f() { PATH=\"$PATH:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin\"; gh auth git-credential \"$@\"; }; f"
