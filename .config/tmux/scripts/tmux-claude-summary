#!/bin/bash
# Ensure PATH includes homebrew
export PATH="/opt/homebrew/bin:$PATH"
# Status-bar summary of Claude agents across all sessions, e.g. "! 1 ✓ 2 ● 3".
# Prints nothing when no agent has a known state. Counts only panes still running
# claude, so stale options on a pane that has since exited are ignored.
# Agents on hold (@claude_hold) are not counted.
# Colours: red blocked, green done (waiting for you), yellow working.

tmux list-panes -a -F '#{pane_current_command} #{?@claude_hold,1,0} #{@claude_state}' | awk '
    $1 == "claude" && $2 == 0 {
        if ($3 == "blocked") b++
        else if ($3 == "done") d++
        else if ($3 == "working") w++
    }
    END {
        out = ""
        if (b) out = out "#[fg=#f38ba8]! " b " "
        if (d) out = out "#[fg=#a6e3a1]✓ " d " "
        if (w) out = out "#[fg=#f9e2af]● " w " "
        if (out != "") printf "%s#[fg=default]", out
    }'
